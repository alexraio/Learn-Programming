# Configurazione d'esempio per TaskMaster API
APP_NAME="TaskMaster API"
API_V1_PREFIX="/api/v1"
DEBUG=false

# Connessione Database (SQLite)
DATABASE_URL="sqlite:///./taskmaster.db"

# Chiave segreta per la firma dei JWT (in produzione generare una stringa casuale a 256 bit)
JWT_SECRET_KEY="generate-a-secure-random-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
